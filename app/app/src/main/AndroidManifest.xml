<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Versión 1 (fase 4). Permisos probados en la fase 2, más Internet para bajar la lista de radares. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Para pedir "batería sin restricciones" con el diálogo directo de Android (pantalla principal). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android Auto (fase 7): plantilla de navegación y dibujar en la pantalla del coche. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <application
        android:name=".AppRadares"
        android:allowBackup="false"
        android:label="Avisos radares"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Modo pro: lista, permisos uno a uno, sonidos, simulaciones, viajes y registro. -->
        <activity
            android:name=".ModoProActivity"
            android:exported="false" />

        <!-- Arranque con el Bluetooth del coche (vía A, fase 2.1). Los avisos de conexión los envía la aplicación
             Bluetooth del sistema (no el propio Android), así que el receptor tiene que estar exportado; si no, el
             sistema descarta el aviso (error de la compilación 9). Son avisos protegidos: solo el sistema puede
             enviarlos. -->
        <receiver
            android:name=".BluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Android Auto (fase 7). Categoría de navegación: la única que deja dibujar lo que se quiera en la pantalla
             del coche. La app no está en Google Play: en Android Auto hay que activar "Fuentes desconocidas". -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <service
            android:name=".CocheServicio"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Avisos radares">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <service
            android:name=".ServicioRadares"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>
